@{
    ViewData["Title"] = "Login";
}

@* Top text *@
<div class="text-center mb-4">
    <p class="tiny-top-moo mb-1">- ZUGANG ZUM STALL & FEED -</p>
    <h1 class="big-moo-title">Wer betritt die Weide?</h1>
    <p class="moo-subtitle mx-auto">
        Wähle deinen Zugang: Verwalte deinen eigenen Marktwert als Kuhfluencer oder buche tierischen Content als Werbekunde.
    </p>
</div>

@* Put two cards one near eachother *@
<div class="row g-4 justify-content-center horny-barn-row mx-auto">

    @* First card creator *@
    <div class="col-md-6">
        <div class="barn-card sexy-cow-card h-100">
            <span class="cow-number">01</span>
            <span class="udder-pill golden-udder-pill">• CREATOR & ADMIN PORTAL</span>

            <h2 class="moo-heading">Kuhfluencer-Login</h2>
            <p class="cow-blabla">
                Verwalte deinen eigenen Wechselkurs oder lade frische Weide-Pics für deine Abonnenten hoch.
            </p>

            <form asp-controller="Animals" asp-action="Creator" method="get">
                <div class="mb-3">
                    <label class="form-label">Ohrmarken-Nummer oder Künstlername</label>
                    <div class="input-group">
                        <span class="input-group-text">#</span>
                        <input type="text" class="form-control" placeholder="z. B. DE-04-BERTA" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Geheimer Stall-PIN / Passwort</label>
                    <div class="input-group">
                        <span class="input-group-text">*</span>
                        <input type="password" class="form-control" placeholder="Dein geheimer Zugang" />
                    </div>
                </div>

                <div class="form-check my-3">
                    <input type="checkbox" class="form-check-input" id="hoofCheck" />
                    <label class="form-check-label" for="hoofCheck">
                        <strong>Ich bestätige, dass ich Hufe habe</strong><br />
                        @* <small class="text-white-50">Kein Roboter</small> *@
                    </label>
                </div>

                <button type="submit" class="btn milk-me-btn w-100 d-flex justify-content-between align-items-center">
                    <span><strong>Ab in den Stall</strong> <small class="ms-1 opacity-75">ADMIN-LOGIN</small></span>
                    <span>→</span>
                </button>
            </form>
        </div>
    </div>

    @* Second card for buyer (redirects to Animals page!) *@
    <div class="col-md-6">
        <div class="barn-card sugar-daddy-card h-100">
            <span class="cow-number">02</span>
            <span class="udder-pill creamy-udder-pill">• WERBEKUNDEN & FANS</span>

            <h2 class="moo-heading">Käufer-Login</h2>
            <p class="cow-blabla">
                Berechne Kampagnen-Budgets im ZSK-Rechner und sichere dir exklusive Weide-Deals.
            </p>

            <form asp-controller="Animals" asp-action="Index" method="get">
                <div class="mb-3">
                    <label class="form-label">Benutzername</label>
                    <div class="input-group">
                        <span class="input-group-text">&#64;</span>
                        <input type="text" name="username" class="form-control" placeholder="z. B. SugarFarmer69" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Passwort</label>
                    <div class="input-group">
                        <span class="input-group-text">*</span>
                        <input type="password" class="form-control" placeholder="Dein Passwort" />
                    </div>
                </div>

                <a asp-controller="Animals" asp-action="Index" class="broke-guest-link d-flex justify-content-between align-items-center my-3">
                    <span>Oder direkt als Gast zum ZSK-Rechner</span>
                    <span>→</span>
                </a>

                <button type="submit" class="btn sugar-daddy-btn w-100 d-flex justify-content-between align-items-center">
                    <strong>Als Käufer einloggen</strong>
                    <span>→</span>
                </button>
            </form>
        </div>
    </div>

</div>

@* Bottom line *@
<div class="text-center mt-4 poop-shovel-footer">
    <strong>100% BIO-AUTHENTIFIZIERUNG</strong> • GEPRÜFT DURCH DIE ZIEGEN-SCHAFE-KUH GMBH & CO. KG
</div>
