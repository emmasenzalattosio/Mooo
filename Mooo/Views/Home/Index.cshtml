@{
    ViewData["Title"] = "Login";
}

@* Top text *@
<div class="text-center mb-4">
    <p class="eyebrow mb-1">&mdash; ZUGANG ZUM STALL &amp; FEED &mdash;</p>
    <h1 class="main-title">Wer betritt die Weide?</h1>
    <p class="subtitle mx-auto">
        Wähle deinen Zugang: Verwalte deinen eigenen Marktwert als Kuhfluencer oder buche tierischen Content als Werbekunde.
    </p>
</div>

@* Put two cards one near eachother *@
<div class="row g-4 justify-content-center login-wrapper mx-auto">

    @* First card creator *@
    <div class="col-md-6">
        <div class="login-card card-dark h-100">
            <span class="card-number">01</span>
            <span class="badge-pill badge-dark-pill">&bull; CREATOR &amp; ADMIN PORTAL</span>

            <h2 class="card-heading">Kuhfluencer-Login</h2>
            <p class="card-text-muted">
                Für Kühe, Schafe und Ziegen mit eigenem Account. Passe deinen Wechselkurs an oder lade neue Weide-Pics hoch.
            </p>

            <form>
                <div class="mb-3">
                    <label class="form-label">Ohrmarken-Nummer oder Künstlername</label>
                    <div class="input-group">
                        <span class="input-group-text">&#127991;</span>
                        <input type="text" class="form-control" placeholder="z. B. DE-04-BERTA" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Geheimer Stall-PIN / Passwort</label>
                    <div class="input-group">
                        <span class="input-group-text">&#128274;</span>
                        <input type="password" class="form-control" placeholder="Dein geheimer Zugang" />
                    </div>
                </div>

                <div class="form-check my-3">
                    <input type="checkbox" class="form-check-input" id="hoofCheck" />
                    <label class="form-check-label" for="hoofCheck">
                        <strong>Ich bestätige, dass ich Hufe habe</strong><br />
                        <small class="text-white-50">Kein Roboter</small>
                    </label>
                </div>
                gfgf
                <button type="submit" class="btn btn-gold w-100 d-flex justify-content-between align-items-center">
                    <span><strong>Ab in den Stall</strong> <small class="ms-1 opacity-75">ADMIN-LOGIN</small></span>
                    <span>&rarr;</span>
                </button>
            </form>
        </div>
    </div>

    

    @* Second card for buyer*@
    <div class="col-md-6">
        <div class="login-card card-light h-100">
            <span class="card-number">02</span>
            <span class="badge-pill badge-light-pill">&bull; WERBEKUNDEN &amp; FANS</span>

            <h2 class="card-heading">Käufer-Login</h2>
            <p class="card-text-muted">
                Berechne Kampagnen-Budgets im ZSK-Rechner und sichere dir exklusive Weide-Deals.
            </p>

            <form>
                <div class="mb-3">
                    <label class="form-label">Business E-Mail-Adresse</label>
                    <div class="input-group">
                        <span class="input-group-text">&#9993;</span>
                        <input type="email" class="form-control" placeholder="z. B. marketing@agentur.de" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Passwort</label>
                    <div class="input-group">
                        <span class="input-group-text">&#128274;</span>
                        <input type="password" class="form-control" placeholder="Dein Passwort" />
                    </div>
                </div>

                <a href="#" class="guest-link d-flex justify-content-between align-items-center my-3">
                    <span>Oder direkt als Gast zum ZSK-Rechner</span>
                    <span>&rarr;</span>
                </a>

                <button type="submit" class="btn btn-espresso w-100 d-flex justify-content-between align-items-center">
                    <strong>Als Käufer einloggen</strong>
                    <span>&rarr;</span>
                </button>

                <hr class="my-3" />
                <p class="text-center small mb-0 text-muted">
                    Neu auf der Weide? <a href="#" class="text-dark fw-bold text-decoration-none">Kostenlosen Zugang anfragen</a>
                </p>
            </form>
        </div>
    </div>

</div>

@* Bottom line *@
<div class="text-center mt-4 bio-footer">
    <strong>100% BIO-AUTHENTIFIZIERUNG</strong> &bull; GEPRÜFT DURCH DIE ZIEGEN-SCHAFE-KUH GMBH &amp; CO. KG
</div>
