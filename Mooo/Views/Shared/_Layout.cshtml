<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OnlyFarms</title>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @* Top navigation line *@
    <header class="top-header d-flex justify-content-between align-items-center px-4 py-3">
        <a class="brand-link d-flex align-items-center gap-2 text-decoration-none" asp-controller="Home" asp-action="Index">
            <span class="logo-circle">&#127969;</span>
            <div>
                <div class="brand-title">OnlyFarms</div>
                <div class="brand-sub">BY ZSK GMBH</div>
            </div>
        </a>

        <a class="back-link d-flex align-items-center gap-2 text-decoration-none" asp-controller="Home" asp-action="Index">
            <div class="text-end">
                <div class="back-title">Zurück zur Weide</div>
                <div class="back-sub">STARTSEITE</div>
            </div>
            <span class="arrow-circle">&rarr;</span>
        </a>
    </header>

    
    <main class="container py-5">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
