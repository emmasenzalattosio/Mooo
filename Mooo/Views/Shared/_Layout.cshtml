<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OnlyFarms</title>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animals.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/creator.css" asp-append-version="true" />
</head>
<body>
    @* Top navigation line *@
    <header class="barn-top-bar d-flex justify-content-between align-items-center px-4 py-3">
        <a class="d-flex align-items-center gap-2 text-decoration-none" asp-controller="Home" asp-action="Index">
            <span class="milk-circle">OF</span>
            <div>
                <div class="onlyfarms-logo-text">OnlyFarms</div>
                <div class="tiny-farm-text">BY ZSK GMBH</div>
            </div>
        </a>

        <a class="d-flex align-items-center gap-2 text-decoration-none" asp-controller="Home" asp-action="Index">
            <div class="text-end">
                <div class="back-to-grass-text">Zurück zur Weide</div>
                <div class="tiny-farm-text">STARTSEITE</div>
            </div>
            <span class="arrow-booty-circle">→</span>
        </a>
    </header>

    <main class="container py-5">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
